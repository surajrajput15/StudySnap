# ─────────────────────────────────────────────
# StudySnap - Environment Variables
# ─────────────────────────────────────────────

# === BACKEND (BACKEND/.env) ===
# ⚠️ PRODUCTION: set NODE_ENV=production. Anything NOT "development" boots
# fail-fast (required env enforced, no mock content, strict CORS + CSP).
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/studynotesai
# ⚠️ PRODUCTION: use LIVE keys (sk_live_ / pk_live_). Test keys = unverified dev-mode sessions.
CLERK_SECRET_KEY=sk_live_xxx
CLERK_PUBLISHABLE_KEY=pk_live_xxx
# Clerk webhook signing secret (for /api/webhooks signature verification; optional in dev)
CLERK_WEBHOOK_SECRET=whsec_xxx
GROQ_API_KEY=gsk_xxx
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=xxx
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
BREVO_API_KEY=xxx
# Optional sender address used for Brevo emails (defaults to study@notes.ai)
BREVO_SENDER_EMAIL=study@notes.ai
PORT=4000
FRONTEND_URL=http://localhost:3000

# === FRONTEND (FRONTEND/.env.local) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
