{
  "name": "studysnap-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "test": "node --no-warnings --import tsx --test tests/corsSecurity.test.ts tests/aiLogging.test.ts tests/envValidation.test.ts tests/aiFailFast.test.ts tests/storageFailClosed.test.ts tests/voiceNoteValidation.test.ts tests/errorStateConsistency.test.ts tests/validationHardening.test.ts tests/authorization.test.ts tests/rateLimitCoverage.test.ts",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@clerk/backend": "^1.25.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@upstash/redis": "^1.38.0",
    "bullmq": "^5.45.0",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "multer": "^2.0.0",
    "svix": "^1.99.1",
    "typescript": "^5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.66.0"
  }
}
