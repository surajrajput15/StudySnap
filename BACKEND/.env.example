# Database
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/studynotesai

# Clerk
# ⚠️ PRODUCTION: MUST use LIVE keys (sk_live_ / pk_live_) from the Clerk dashboard.
#    Test keys (sk_test_ / pk_test_) give unverified, dev-mode sessions — never use in production.
CLERK_SECRET_KEY=sk_live_xxx
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx   # Svix signing secret from Clerk Dashboard → Webhooks → Endpoint

# AI — ⚠️ MUST set in production for real AI responses
GROQ_API_KEY=gsk_xxx

# Redis (Upstash)
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Email (Brevo)
BREVO_API_KEY=xxx
BREVO_SENDER_EMAIL=study@notes.ai

# Server
PORT=4000
NODE_ENV=development              # Change to "production" on Render
FRONTEND_URL=http://localhost:3000 # ⚠️ MUST be your Vercel frontend URL in production!
                                  # Example: https://studysnap-sigma.vercel.app
